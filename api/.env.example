# Copy to api/.env (gitignored). Never commit real values.
GEMINI_API_KEY=
# Model ids are config, not code (TRD §10.1). Verifier must differ from writer; pick the cheapest that passes evals.
# Must be Gemini 3+ models (the gateway sends thinking_level). Use a paid-tier key before any real user data.
LLM_MODEL_FAST=
LLM_MODEL_WRITER=
LLM_MODEL_VERIFIER=
ENV=development
# Roles come from alembic/bootstrap.sql. API = hunt_app, worker = hunt_worker, migrations = hunt_owner.
DATABASE_URL=postgresql+psycopg://hunt_app:change-me@localhost:5432/hunt
WORKER_DATABASE_URL=postgresql+psycopg://hunt_worker:change-me@localhost:5432/hunt
MIGRATION_DATABASE_URL=postgresql+psycopg://hunt_owner:change-me@localhost:5432/hunt
# >= 16 chars; salts the pseudonym that replaces user_id in audit_log/llm_calls on deletion.
PSEUDONYM_SALT=
# OIDC login: bearer ID tokens are verified against the provider's JWKS. Issuer exactly as the provider's
# discovery `issuer` (Auth0 keeps the trailing slash). Audience = the frontend's OIDC_CLIENT_ID.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Optional: JWKS URL if the provider has no /.well-known/openid-configuration.
# OIDC_JWKS_URL=
# Optional overrides (defaults = TRD §15.1 / PRD §7 proposed values):
# FREE_TAILORED_PER_MONTH=10
# FREE_DEEP_MATCHES_PER_MONTH=30
# UPLOAD_MAX_MB=10
# Uploaded originals and rendered exports (keys prefixed by user_id). Default: api/var/storage
# STORAGE_DIR=
# Deletion tombstones, outside the DB and its backups. Default: api/var/tombstones. Must differ from STORAGE_DIR;
# in production point it at an object-locked (WORM) bucket mount so files can't be overwritten or deleted.
# TOMBSTONE_DIR=
# Superuser/BYPASSRLS URL, used only by `python -m app.tasks.reapply_tombstones` after a restore.
# RESTORE_DATABASE_URL=
# TASK_MAX_ATTEMPTS=5
# TASK_LEASE_SECONDS=300
# EVIDENCE_PACK_TOKENS=4000
# Global LLM spend cap per UTC day (USD); when hit, model tasks wait until the next day.
# LLM_DAILY_SPEND_CAP_USD=5
# USD per 1M tokens, used for llm_calls.cost: LLM_PRICE_{FAST,WRITER,VERIFIER}_{IN,OUT}
# LLM_PRICE_FAST_IN=0.30
# LLM_PRICE_FAST_OUT=2.50
# LLM_PRICE_WRITER_IN=0.75
# LLM_PRICE_WRITER_OUT=3.75
