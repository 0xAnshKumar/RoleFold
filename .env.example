# Frontend (Next.js). Copy to .env.local.
# FastAPI base URL, used by server rendering and the /v1 proxy.
API_URL=http://127.0.0.1:8000
# Dev-only identity sent as X-Dev-User (letters, digits, _ . -). Leave unset for demo mode (sample data).
NEXT_PUBLIC_DEV_USER=
# Set to 1 to force demo mode even when the API is up.
HUNT_DEMO=
