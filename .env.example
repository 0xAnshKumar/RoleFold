# Frontend (Next.js). Copy to .env.local.
# FastAPI base URL, used by server rendering and the /v1 proxy.
API_URL=http://127.0.0.1:8000
# Dev-only identity sent as X-Dev-User (letters, digits, _ . -). Leave unset for demo mode (sample data).
NEXT_PUBLIC_DEV_USER=
# Set to 1 to force demo mode even when the API is up.
HUNT_DEMO=
# OIDC sign-in (any provider). Issuer must match api/.env OIDC_ISSUER exactly; client id = api OIDC_AUDIENCE.
# Register redirect URI {APP_URL}/auth/callback and post-logout URI {APP_URL}/ with the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Public origin used for redirect URIs (e.g. https://hunt.example.com). Defaults to the request origin.
APP_URL=
