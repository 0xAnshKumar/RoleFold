# Frontend (Next.js). Copy to .env.local.
# FastAPI base URL, used by server rendering and the /v1 proxy.
API_URL=http://127.0.0.1:8000
# Dev-only identity sent as X-Dev-User (letters, digits, _ . -). Leave unset when using OIDC sign-in.
NEXT_PUBLIC_DEV_USER=
# OIDC sign-in (any provider). Issuer must match api/.env OIDC_ISSUER exactly; client id = api OIDC_AUDIENCE.
# Register redirect URI {APP_URL}/auth/callback and post-logout URI {APP_URL}/ with the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 32+ random characters (openssl rand -base64 32). Encrypts the refresh token cookie (AES-GCM). With it set, sign-in
# asks for offline_access when the provider lists it, and expired sessions renew silently; unset = sign in again
# when the ID token expires. Changing it signs everyone out at their next expiry. Providers that don't list
# offline_access in discovery (Google) don't get a refresh token. Logout revokes it where the provider supports that.
SESSION_SECRET=
# Public origin used for redirect URIs (e.g. https://hunt.example.com). Defaults to the request origin.
APP_URL=
